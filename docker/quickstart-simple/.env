# The only value you normally need to change.
# Set this to the DataHub image tag/version you want to run, then:
#
#     docker compose up -d
#
# Examples: v1.5.0.6, v1.4.0.3, head (head = locally built images).
# Available tags: https://hub.docker.com/u/acryldata
DATAHUB_VERSION=v1.5.0.6

# --- Optional overrides (uncomment to change) ---
# DATAHUB_MAPPED_FRONTEND_PORT=9002
# DATAHUB_MAPPED_GMS_PORT=8080
# METADATA_SERVICE_AUTH_ENABLED=true
# DATAHUB_TELEMETRY_ENABLED=true
